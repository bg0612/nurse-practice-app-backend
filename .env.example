# Server
PORT=3001
CORS_ORIGIN=http://localhost:5174

# Provider mode: "mock" (deterministic, no network) or "live"
PROVIDER_MODE=mock

# Service toggles (true/false). When false, related API routes return 503.
LLM_ENABLED=true

# LLM model (OpenRouter id) — required; change here to swap models
LLM_MODEL=deepseek/deepseek-v4-flash

# Secrets — server only; never expose to the Vite client
# Used for LLM chat via OpenRouter
OPENROUTER_API_KEY=
