# Server
PORT=3001
# Comma-separated explicit browser origins; wildcards are rejected.
CORS_ORIGINS=http://localhost:5174

# "mock" is deterministic and performs no provider network calls; "live" fails
# fast unless all required provider configuration is valid.
PROVIDER_MODE=mock
LLM_ENABLED=true
SPEECH_ENABLED=true

# Temporary OpenRouter adapter (server only). Switch these selectors back to
# microsoft-foundry / azure-speech without changing the application flow.
LLM_PROVIDER=openrouter
TTS_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=nova
OPENROUTER_TTS_FORMAT=mp3
OPENROUTER_TTS_SPEED=1
OPENROUTER_TTS_TIMEOUT_MS=15000

# Retained Microsoft Foundry Direct-from-Azure DeepSeek configuration.
FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
FOUNDRY_DEPLOYMENT_NAME=your-deepseek-v4-flash-deployment
FOUNDRY_MODEL=DeepSeek-V4-Flash
FOUNDRY_MODEL_VERSION=2026-04-23
FOUNDRY_DEPLOYMENT_TYPE=pay-as-you-go
FOUNDRY_AUTH_MODE=api-key
FOUNDRY_API_KEY=
FOUNDRY_TIMEOUT_MS=20000

# Retained Azure Speech synthesis configuration. Voice and per-case output settings come
# from the validated CaseConfig. Managed identity uses an injected token provider.
AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com
AZURE_SPEECH_AUTH_MODE=api-key
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_DEFAULT_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_SPEECH_TIMEOUT_MS=15000
